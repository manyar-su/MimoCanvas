# ============================================================
# API Keys - copy this file to .env and fill in your values
# ============================================================

# RunPod API Key (for runpodImage and runpodChat providers)
VITE_RUNPOD_API_KEY=your_runpod_api_key_here

# Chatfire / Mimo default API Key
VITE_CHATFIRE_API_KEY=your_chatfire_api_key_here

# OpenAI API Key
VITE_OPENAI_API_KEY=your_openai_api_key_here

# Sumopod API Key
VITE_SUMOPOD_API_KEY=your_sumopod_api_key_here

# Default API Base URL (optional, defaults to https://api.chatfire.site)
# VITE_API_BASE_URL=https://api.chatfire.site
